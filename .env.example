# ---------------------------------------------------------------------------
# Capere AI — environment template
# Copy to .env and fill in. Never commit .env.
# Every var is validated at boot by shared/config — the service fails fast with
# a readable message if a required var is missing or malformed.
# ---------------------------------------------------------------------------

# --- General ---
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
# CORS origins for Open WebUI, comma-separated
CORS_ORIGINS=http://localhost:8080

# --- Supabase PostgreSQL ---
# Use the Supabase pooler connection string for development, testing, and deployment:
#   postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
# Keep separate Supabase projects for production and testing.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres
# The server-side service client must use a Supabase service role/BYPASSRLS credential
# where required by the deployment. Never expose it to clients.
DATABASE_SERVICE_ROLE_KEY=
# Required in production. Base64-encode the trusted Supabase/PostgreSQL CA PEM:
#   base64 -w0 supabase-ca.pem
DATABASE_SSL_CA_BASE64=

# --- Supabase Auth (JWT verification) ---
# For hosted Supabase (HS256 mode):
#   SUPABASE_JWT_SECRET=<your JWT secret from project settings>
# For local `supabase start` (also HS256): use its anon JWT secret.
# For hosted Supabase in JWKS mode: leave SUPABASE_JWT_SECRET empty and set:
#   SUPABASE_PROJECT_URL=https://<project-ref>.supabase.co
#   SUPABASE_AUDIENCE=authenticated
# When both are set, SUPABASE_JWT_SECRET takes precedence.
SUPABASE_JWT_SECRET=
SUPABASE_PROJECT_URL=
SUPABASE_AUDIENCE=authenticated
SUPABASE_ISSUER=

# --- Auth (API keys for Open WebUI and machine clients) ---
# Generate with: openssl rand -base64 32
API_KEYS_HASHING_SALT=replace-me

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379

# --- GoHighLevel ---
GHL_API_BASE_URL=https://services.leadconnectorhq.com
GHL_WEBHOOK_SECRET=
GHL_WEBHOOK_PUBLIC_KEY_BASE64=
GHL_WEBHOOK_ED25519_PUBLIC_KEY_BASE64=
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
GHL_SSO_KEY=
GHL_OAUTH_REDIRECT_URI=https://api.capereai.com/api/v1/integrations/crm/callback
GHL_AUTHORIZATION_URL=https://marketplace.gohighlevel.com/oauth/chooselocation
GHL_TOKEN_URL=https://services.leadconnectorhq.com/oauth/token

# --- Google OAuth (GA4, GSC, GBP) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.capereai.com/api/v1/integrations/google/callback

# --- DataForSEO platform account ---
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- GitHub App ---
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=

# --- OpenRouter ---
# Required in production. Leave empty only in development or test to use the
# deterministic fake LLM and embedding providers without network access.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Comma-separated fallback chains. General and analytics use Nemotron first,
# then paid DeepSeek/Qwen fallbacks. Review stays free-first and excludes Qwen,
# whose OpenRouter route does not reliably satisfy the JSON review contract.
OPENROUTER_MODELS_GENERAL=nvidia/nemotron-3-ultra-550b-a55b:free,deepseek/deepseek-v4-flash,qwen/qwen3.8-max
OPENROUTER_MODELS_ANALYTICS=nvidia/nemotron-3-ultra-550b-a55b:free,deepseek/deepseek-v4-flash,qwen/qwen3.8-max
OPENROUTER_MODELS_CHEAP=nvidia/nemotron-3-ultra-550b-a55b:free,deepseek/deepseek-v4-flash

# --- Encryption (envelope encryption for integration credentials) ---
# Generate the data key with: openssl rand -base64 32
# KEY_ENCRYPTION_KEY should be a base64-encoded 32-byte value.
KEY_ENCRYPTION_KEY=replace-me
# The key version currently in use. Increment when rotating: old versions remain
# readable for decryption; new writes use the new version.
ENCRYPTION_KEY_VERSION=1

# --- Vector store / RAG ---
VECTOR_STORE_PROVIDER=pgvector
# Only used when VECTOR_STORE_PROVIDER=qdrant.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=capere-rag
RAG_VECTOR_WRITE_BATCH_SIZE=250

# --- Open WebUI ---
# Issue an organization-bound API key with:
#   pnpm api-key:issue <organization-id> "Open WebUI" office_manager
# Store the one-time raw value here. Docker Compose passes it to Open WebUI as
# OPENAI_API_KEY; the backend does not read this variable.
OPEN_WEBUI_API_KEY=
# Pin a reviewed version or immutable digest; the floating `main` tag is unsafe.
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:<version-or-digest>
