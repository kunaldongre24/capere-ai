{
  "name": "@capere/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Capere AI stateless intelligence layer over GoHighLevel",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "nest start --watch",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "rimraf dist tsconfig.build.tsbuildinfo && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "migrate": "tsx src/shared/database/cli/migrate.ts up",
    "migrate:down": "tsx src/shared/database/cli/migrate.ts down",
    "api-key:issue": "tsx src/auth/cli/issue-api-key.ts",
    "rag:rebuild-vectors": "tsx src/rag/cli/rebuild-vectors.ts",
    "db:types": "kysely-codegen --out-file src/shared/database/generated/db.ts --log-level info"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.22.0",
    "@nestjs/common": "^10.4.6",
    "@nestjs/core": "^10.4.6",
    "@nestjs/platform-express": "^10.4.6",
    "@nestjs/swagger": "^8.0.1",
    "@nestjs/throttler": "^6.2.1",
    "bullmq": "^5.30.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "kysely": "^0.27.4",
    "nestjs-pino": "^4.1.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^11.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.8",
    "@nestjs/testing": "^10.4.6",
    "@swc/core": "^1.15.47",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "kysely-codegen": "^0.20.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.1.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "unplugin-swc": "^1.5.10",
    "vitest": "^2.1.4"
  }
}
